#!/usr/bin/env python3
import errno
import os
import sys

if len(sys.argv) < 2:
    print("usage: setsid command [args ...]", file=sys.stderr)
    raise SystemExit(2)

argv = sys.argv[1:]

try:
    os.setsid()
except OSError as exc:
    if exc.errno != errno.EPERM:
        raise
    # GNU setsid forks when the caller is already a process-group leader.
    pid = os.fork()
    if pid > 0:
        os._exit(0)
    os.setsid()

os.execvp(argv[0], argv)
