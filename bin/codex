#!/usr/bin/env bash
set -eo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DANUS_ROOT="$(cd "$HERE/.." && pwd)"

. "$DANUS_ROOT/scripts/env.sh" >/dev/null

REAL_CODEX="${DANUS_SYSTEM_CODEX:-}"
if [ -z "$REAL_CODEX" ]; then
  # Linux bootstrap provisions Node + codex.js. Keep its original launch
  # environment and arguments; host-Codex isolation is configured below.
  if [ -x "${DANUS_NODE:-}" ] && [ -f "${DANUS_CODEX_JS:-}" ]; then
    exec "$DANUS_NODE" "$DANUS_CODEX_JS" "$@"
  fi
  echo "Danus: Codex unavailable; run scripts/bootstrap.sh (Linux) or scripts/bootstrap-mac.sh (macOS)" >&2
  exit 127
fi
if [ ! -x "$REAL_CODEX" ]; then
  echo "Danus: host Codex unavailable; run scripts/bootstrap-mac.sh" >&2
  exit 127
fi

export CODEX_HOME="$DANUS_ROOT/runtime/codex-home"
export TMPDIR="$DANUS_ROOT/runtime/tmp"
mkdir -p "$CODEX_HOME" "$TMPDIR"
"$DANUS_PY" "$DANUS_ROOT/scripts/codex-paths.py" "$CODEX_HOME/config.toml" "$DANUS_ROOT"

args=()
explicit_sandbox=0
while (($#)); do
  case "$1" in
    --dangerously-bypass-approvals-and-sandbox|\
    --dangerously-bypass-approvals-and-sandbox=*|\
    --yolo|--yolo=*)
      ;;
    --sandbox|--sandbox=*|-s|-s?*)
      explicit_sandbox=1
      args+=("$1")
      ;;
    *)
      args+=("$1")
      ;;
  esac
  shift
done

# Interactive model/effort come from .codex/config.toml (or explicit CLI flags).
# The Python launcher supplies both settings for background `exec` sessions.
if [ "${#args[@]}" -eq 0 ] || [[ "${args[0]}" == -* ]]; then
  cd "$DANUS_ROOT"
fi

# Seatbelt is inherited even by detached worker processes and cannot be applied
# twice. Disable only Codex's second sandbox when the OS confirms one already
# exists. All commands still inherit the parent's filesystem/network boundary.
# Never infer this from CODEX_SANDBOX alone, and keep explicit sandbox requests.
if [ "$explicit_sandbox" -eq 0 ] && \
   "$DANUS_PY" "$DANUS_ROOT/scripts/codex-sandbox.py"; then
  exec "$REAL_CODEX" --dangerously-bypass-approvals-and-sandbox "${args[@]}"
fi

exec "$REAL_CODEX" "${args[@]}"
